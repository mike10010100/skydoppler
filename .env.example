# ==============================================================================
# SkyDoppler Configuration Template
# ==============================================================================

# Web Server & Host Bind
HOST=0.0.0.0
PORT=3000
PORT_BIND=3032
MEM_LIMIT=1024M
RUST_LOG=info,skydoppler=info,skybase=info

# SQLite WAL Projection Store
SKYDOPPLER_DATABASE_PATH=/data/skydoppler.db

# Fail-Closed Small-Account Redaction Threshold (followers)
SKYDOPPLER_PUBLIC_FOLLOWER_THRESHOLD=5000

# Optional Operator Bearer Token (>= 16 random chars; leave blank to disable operator unlock)
SKYDOPPLER_OPERATOR_TOKEN=

# Optional CORS Origins (comma-separated)
# SKYDOPPLER_CORS_ORIGINS=https://doppler.example.com

# Streaming Radar Thresholds & Caps
SKYDOPPLER_SHORT_WINDOW_SECS=300
SKYDOPPLER_MEDIUM_WINDOW_SECS=1800
SKYDOPPLER_MIN_UNIQUE_AUTHORS=8
SKYDOPPLER_MIN_STREAMING_RATIO=0.50
SKYDOPPLER_MAX_TRACKED_POSTS=20000
SKYDOPPLER_MAX_TRACKED_AUTHORS=20000
SKYDOPPLER_ALERT_COOLDOWN_SECS=600
SKYDOPPLER_STORM_TTL_SECS=1800
SKYDOPPLER_HISTORY_RETENTION_SECS=604800

# AppView Politeness & Timeouts
SKYDOPPLER_APPVIEW_URL=https://public.api.bsky.app
SKYDOPPLER_APPVIEW_RPS=4.0

# Optional Stage 3 Bundled LLM Stance Verifier (disabled by default; structural fallback active)
SKYDOPPLER_ENABLE_LLM_STANCE=false
# SKYDOPPLER_STANCE_BASE_URL=http://localhost:11434
# SKYDOPPLER_STANCE_MODEL=qwen3.5:9b
# SKYDOPPLER_STANCE_API_KEY=
